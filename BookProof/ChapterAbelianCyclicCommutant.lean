import Mathlib
import BookProof.ChapterAbelianCyclicModel
import BookProof.ChapterSpectralCommutant

/-!
# The commutant of an arbitrary abelian algebra with a cyclic vector (plan GAP-2)

`ChapterSpectralCommutant` computes the commutant of the algebra generated by a
**single** normal operator with a cyclic vector: it is the unitary copy of `L∞(μ)`
acting by multiplication, so that algebra is maximal abelian.
`ChapterAbelianCyclicModel` removes the "single operator" restriction from the
*model*: an arbitrary unital `*`-representation `π : C(X, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H)`
with a cyclic unit vector is unitarily multiplication on `L²(μ)`.

This module removes it from the *commutant* computation as well, which is the von
Neumann level of the same statement:

* `conjRep` / `conjRepSymm` — conjugation by the unitary of the cyclic model;
* `repSet` — the represented algebra `{π(g) : g ∈ C(X, ℂ)} ⊆ B(H)`;
* `multModelRep` — the unitary copy inside `B(H)` of the multiplication algebra
  `L∞(μ)`;
* `centralizer_repSet` — HEADLINE: the **commutant** of `{π(g)}` is exactly that
  copy of `L∞(μ)`;
* `centralizer_multModelRep`, `bicommutant_repSet` — the copy is its own commutant,
  so the **von Neumann algebra generated by `{π(g)}`** (its bicommutant) is that
  same copy of `L∞(μ)`;
* `commutant_repSet_isCommutative` — the commutant is abelian: the algebra is
  **maximal abelian**;
* `abelian_algebra_maximal_abelian_of_cyclic` — the Gelfand form: for every
  representation `ρ` of a commutative unital C\*-algebra `A` with a cyclic unit
  vector, the commutant of `ρ(A)` is abelian and equals the bicommutant of `ρ(A)`,
  a unitary copy of `L∞(μ)` for a Borel probability measure `μ` on the character
  space of `A`.

Compared with `ChapterSpectralCommutant` no generator of the algebra is assumed:
`A` need not be singly generated, and no separability is used.

Everything is `sorry`-free and `axiom`-free.
-/

noncomputable section

open MeasureTheory Complex WeakDual

namespace BookProof.ChapterAbelianCyclicCommutant

open BookProof.ChapterLinftyMultiplication BookProof.ChapterLinftyMaximalAbelian
open BookProof.ChapterAbelianGelfandModel BookProof.ChapterSpectralCommutant
open BookProof.ChapterAbelianCyclicModel

section Rep

variable {X : Type*} [TopologicalSpace X] [CompactSpace X] [T2Space X]
  [MeasurableSpace X] [BorelSpace X]
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable (pi : C(X, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H)) (xi : H) (hcyc : DenseRange (repVec pi xi))

/-- Conjugation of an operator on `L²(μ)` by the unitary of the cyclic model. -/
def conjRep (S : Lp ℂ 2 (repMeasure pi xi) →L[ℂ] Lp ℂ 2 (repMeasure pi xi)) : H →L[ℂ] H :=
  ((cyclicRepUnitary pi xi hcyc).toLinearIsometry.toContinuousLinearMap).comp
    (S.comp ((cyclicRepUnitary pi xi hcyc).symm.toLinearIsometry.toContinuousLinearMap))

@[simp] theorem conjRep_apply
    (S : Lp ℂ 2 (repMeasure pi xi) →L[ℂ] Lp ℂ 2 (repMeasure pi xi)) (v : H) :
    conjRep pi xi hcyc S v
      = cyclicRepUnitary pi xi hcyc (S ((cyclicRepUnitary pi xi hcyc).symm v)) := rfl

/-- Conjugation of an operator on `H` back to `L²(μ)`. -/
def conjRepSymm (S : H →L[ℂ] H) :
    Lp ℂ 2 (repMeasure pi xi) →L[ℂ] Lp ℂ 2 (repMeasure pi xi) :=
  ((cyclicRepUnitary pi xi hcyc).symm.toLinearIsometry.toContinuousLinearMap).comp
    (S.comp ((cyclicRepUnitary pi xi hcyc).toLinearIsometry.toContinuousLinearMap))

@[simp] theorem conjRepSymm_apply (S : H →L[ℂ] H) (u : Lp ℂ 2 (repMeasure pi xi)) :
    conjRepSymm pi xi hcyc S u
      = (cyclicRepUnitary pi xi hcyc).symm (S (cyclicRepUnitary pi xi hcyc u)) := rfl

theorem conjRep_conjRepSymm (S : H →L[ℂ] H) :
    conjRep pi xi hcyc (conjRepSymm pi xi hcyc S) = S := by
  refine ContinuousLinearMap.ext fun v => ?_
  simp

theorem conjRepSymm_conjRep (S : Lp ℂ 2 (repMeasure pi xi) →L[ℂ] Lp ℂ 2 (repMeasure pi xi)) :
    conjRepSymm pi xi hcyc (conjRep pi xi hcyc S) = S := by
  refine ContinuousLinearMap.ext fun u => ?_
  simp

theorem conjRep_mul (A B : Lp ℂ 2 (repMeasure pi xi) →L[ℂ] Lp ℂ 2 (repMeasure pi xi)) :
    conjRep pi xi hcyc (A * B) = conjRep pi xi hcyc A * conjRep pi xi hcyc B := by
  refine ContinuousLinearMap.ext fun v => ?_
  simp [ContinuousLinearMap.mul_apply]

/-- The represented algebra `{π(g)} ⊆ B(H)`. -/
def repSet : Set (H →L[ℂ] H) := Set.range fun g : C(X, ℂ) => pi g

/-- The unitary copy of the multiplication algebra `L∞(μ)` inside `B(H)`. -/
def multModelRep : Set (H →L[ℂ] H) :=
  conjRep pi xi hcyc '' multAlgebra (repMeasure pi xi)

theorem mem_multModelRep_iff (S : H →L[ℂ] H) :
    S ∈ multModelRep pi xi hcyc ↔
      conjRepSymm pi xi hcyc S ∈ multAlgebra (repMeasure pi xi) := by
  constructor
  · rintro ⟨A, hA, rfl⟩
    rwa [conjRepSymm_conjRep]
  · intro h
    exact ⟨conjRepSymm pi xi hcyc S, h, conjRep_conjRepSymm pi xi hcyc S⟩

/-- **The commutation condition transported.**  `S` commutes with every `π(g)` iff its
conjugate on `L²(μ)` commutes with multiplication by every continuous symbol. -/
theorem commutesWithContMult_conjRepSymm {S : H →L[ℂ] H}
    (hS : ∀ g : C(X, ℂ), pi g * S = S * pi g) :
    CommutesWithContMult (conjRepSymm pi xi hcyc S) := by
  intro g
  refine ContinuousLinearMap.ext fun u => ?_
  simp only [ContinuousLinearMap.coe_comp', Function.comp_apply, conjRepSymm_apply]
  have h1 : cyclicRepUnitary pi xi hcyc (mulRep (repMeasure pi xi) g u)
      = pi g (cyclicRepUnitary pi xi hcyc u) :=
    cyclicRepUnitary_intertwines pi xi hcyc g u
  have h2 := congrArg (fun P : H →L[ℂ] H => P (cyclicRepUnitary pi xi hcyc u)) (hS g)
  simp only [ContinuousLinearMap.mul_apply] at h2
  have h3 : cyclicRepUnitary pi xi hcyc
        (mulRep (repMeasure pi xi) g
          ((cyclicRepUnitary pi xi hcyc).symm (S (cyclicRepUnitary pi xi hcyc u))))
      = pi g (S (cyclicRepUnitary pi xi hcyc u)) := by
    rw [cyclicRepUnitary_intertwines pi xi hcyc g, LinearIsometryEquiv.apply_symm_apply]
  rw [h1, ← h2, ← h3, LinearIsometryEquiv.symm_apply_apply]

include hcyc in
/-- **HEADLINE (the commutant of an arbitrary abelian algebra with a cyclic vector).**
An operator commutes with every `π(g)` exactly when it is the unitary copy of a
multiplication operator with essentially bounded symbol: the commutant of the
represented algebra *is* `L∞(μ)`. -/
theorem centralizer_repSet : (repSet pi).centralizer = multModelRep pi xi hcyc := by
  apply Set.eq_of_subset_of_subset
  · intro S hS
    have hcomm : ∀ g : C(X, ℂ), pi g * S = S * pi g := fun g => hS _ ⟨g, rfl⟩
    rw [mem_multModelRep_iff]
    exact contCommutant_mem_multAlgebra (commutesWithContMult_conjRepSymm pi xi hcyc hcomm)
  · rintro S hS R ⟨g, rfl⟩
    obtain ⟨psi, hpsi, hSeq⟩ := (mem_multModelRep_iff pi xi hcyc S).1 hS
    have hS' : S = conjRep pi xi hcyc (multOp psi hpsi) := by
      rw [← hSeq, conjRep_conjRepSymm]
    subst hS'
    refine ContinuousLinearMap.ext fun v => ?_
    simp only [ContinuousLinearMap.mul_apply, conjRep_apply]
    have hcomm := multOp_comm (μ := repMeasure pi xi) psi (fun x => g x) hpsi
      (contMemLpTop _ g)
    have hkey := congrArg
      (fun P : Lp ℂ 2 (repMeasure pi xi) →L[ℂ] Lp ℂ 2 (repMeasure pi xi) =>
        P ((cyclicRepUnitary pi xi hcyc).symm v)) hcomm
    simp only [ContinuousLinearMap.coe_comp', Function.comp_apply] at hkey
    have h1 : cyclicRepUnitary pi xi hcyc
          (mulRep (repMeasure pi xi) g
            (multOp psi hpsi ((cyclicRepUnitary pi xi hcyc).symm v)))
        = pi g (cyclicRepUnitary pi xi hcyc
            (multOp psi hpsi ((cyclicRepUnitary pi xi hcyc).symm v))) :=
      cyclicRepUnitary_intertwines pi xi hcyc g _
    have h2 : (cyclicRepUnitary pi xi hcyc).symm (pi g v)
        = mulRep (repMeasure pi xi) g ((cyclicRepUnitary pi xi hcyc).symm v) := by
      have := cyclicRepUnitary_intertwines pi xi hcyc g ((cyclicRepUnitary pi xi hcyc).symm v)
      rw [LinearIsometryEquiv.apply_symm_apply] at this
      rw [← this, LinearIsometryEquiv.symm_apply_apply]
    rw [h2, ← h1]
    exact congrArg (cyclicRepUnitary pi xi hcyc) hkey.symm

include hcyc in
/-- **The model is its own commutant**: the transported multiplication algebra is a von
Neumann algebra. -/
theorem centralizer_multModelRep :
    (multModelRep pi xi hcyc).centralizer = multModelRep pi xi hcyc := by
  apply Set.eq_of_subset_of_subset
  · intro S hS
    rw [mem_multModelRep_iff]
    rw [← centralizer_multAlgebra (μ := repMeasure pi xi)]
    intro A hA
    have hmem : conjRep pi xi hcyc A ∈ multModelRep pi xi hcyc := ⟨A, hA, rfl⟩
    have h := hS _ hmem
    refine ContinuousLinearMap.ext fun u => ?_
    have h2 := congrArg (fun P : H →L[ℂ] H => P (cyclicRepUnitary pi xi hcyc u)) h
    simp only [ContinuousLinearMap.mul_apply, conjRep_apply,
      LinearIsometryEquiv.symm_apply_apply] at h2
    simp only [ContinuousLinearMap.mul_apply, conjRepSymm_apply]
    have h3 := congrArg (cyclicRepUnitary pi xi hcyc).symm h2
    rwa [LinearIsometryEquiv.symm_apply_apply] at h3
  · rintro S hS R ⟨A, hA, rfl⟩
    obtain ⟨B, hB, rfl⟩ := hS
    rw [← conjRep_mul, ← conjRep_mul, multAlgebra_comm hA hB]

/-- **The bicommutant** — the von Neumann algebra generated by the represented abelian
algebra — is the unitary copy of `L∞(μ)`. -/
theorem bicommutant_repSet :
    (repSet pi).centralizer.centralizer = multModelRep pi xi hcyc := by
  rw [centralizer_repSet pi xi hcyc, centralizer_multModelRep pi xi hcyc]

include hcyc in
/-- **Maximal abelianness.**  The commutant of the represented algebra is commutative,
so no operator outside the model can be adjoined without breaking commutativity. -/
theorem commutant_repSet_isCommutative {S R : H →L[ℂ] H}
    (hS : S ∈ (repSet pi).centralizer) (hR : R ∈ (repSet pi).centralizer) :
    S * R = R * S := by
  rw [centralizer_repSet pi xi hcyc] at hS hR
  obtain ⟨A, hA, rfl⟩ := hS
  obtain ⟨B, hB, rfl⟩ := hR
  rw [← conjRep_mul, ← conjRep_mul, multAlgebra_comm hA hB]

end Rep

/-! ## The Gelfand form -/

section Gelfand

variable {A : Type*} [CommCStarAlgebra A]
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

theorem repSet_gelfandRep (rho : A →⋆ₐ[ℂ] (H →L[ℂ] H)) :
    repSet (gelfandRep rho) = Set.range fun a : A => rho a := by
  ext S
  constructor
  · rintro ⟨f, rfl⟩
    exact ⟨(gelfandModel A).symm f, rfl⟩
  · rintro ⟨a, rfl⟩
    exact ⟨gelfandModel A a, by simp⟩

theorem denseRange_repVec_gelfandRep {rho : A →⋆ₐ[ℂ] (H →L[ℂ] H)} {xi : H}
    (hcyc : DenseRange fun a : A => rho a xi) :
    DenseRange (repVec (gelfandRep rho) xi) := by
  have hrange : Set.range (repVec (gelfandRep rho) xi) = Set.range fun a : A => rho a xi := by
    ext v
    constructor
    · rintro ⟨f, rfl⟩
      exact ⟨(gelfandModel A).symm f, rfl⟩
    · rintro ⟨a, rfl⟩
      exact ⟨gelfandModel A a, by simp [repVec]⟩
  rw [DenseRange, hrange]
  exact hcyc

/-- **HEADLINE (maximal abelianness of an arbitrary abelian algebra with a cyclic
vector).**  Let `ρ` be a unital `*`-representation of a commutative unital
C\*-algebra `A` on a complex Hilbert space `H` with a cyclic unit vector.  Then the
commutant of `ρ(A)` is a commutative set of operators, and the von Neumann algebra
generated by `ρ(A)` — its bicommutant — coincides with that commutant: `ρ(A)` is
*maximal abelian*, and both are the unitary copy of the multiplication algebra
`L∞(μ)` of a measure on the character space of `A`.

No generator of `A` and no separability of `H` are assumed; this is the von Neumann
level of `ChapterAbelianCyclicModel.abelian_algebra_multiplication_model`. -/
theorem abelian_algebra_maximal_abelian_of_cyclic (rho : A →⋆ₐ[ℂ] (H →L[ℂ] H)) (xi : H)
    (hcyc : DenseRange fun a : A => rho a xi) :
    (Set.range fun a : A => rho a).centralizer.centralizer
        = (Set.range fun a : A => rho a).centralizer ∧
      ∀ S R : H →L[ℂ] H, S ∈ (Set.range fun a : A => rho a).centralizer →
        R ∈ (Set.range fun a : A => rho a).centralizer → S * R = R * S := by
  have hcyc' := denseRange_repVec_gelfandRep hcyc
  have hset := repSet_gelfandRep rho
  constructor
  · rw [← hset, bicommutant_repSet (gelfandRep rho) xi hcyc',
      centralizer_repSet (gelfandRep rho) xi hcyc']
  · intro S R hS hR
    rw [← hset] at hS hR
    exact commutant_repSet_isCommutative (gelfandRep rho) xi hcyc' hS hR

end Gelfand

end BookProof.ChapterAbelianCyclicCommutant

end
