open scoped InnerProductSpace

namespace BookProof.ChapterGaugeShiftExample

open BookProof.ChapterContinuityUnitaryInfinite

/-- Composition of lattice translations. -/
theorem shiftOp_mul (m n : ℤ) :
    shiftOp m * shiftOp n = shiftOp (m + n) := by
  ext f k
  change ((shiftOp m (shiftOp n f) : L2Z) : ℤ → ℂ) k
      = ((shiftOp (m + n) f : L2Z) : ℤ → ℂ) k
  simp only [shiftOp_apply]
  have hk : k + m + n = k + (m + n) := by ring
  rw [hk]

/-- The zero translation is the identity. -/
@[simp] theorem shiftOp_zero : shiftOp 0 = (1 : L2Z →L[ℂ] L2Z) := by
  ext f k
  change ((shiftOp 0 f : L2Z) : ℤ → ℂ) k = ((f : L2Z) : ℤ → ℂ) k
  simp

/-- **The gauge algebra of the translations is commutative** — the book's
*commutative* von Neumann algebra whose spectrum the gauge group moves. -/
theorem shiftOp_commute (m n : ℤ) : shiftOp m * shiftOp n = shiftOp n * shiftOp m := by
  rw [shiftOp_mul, shiftOp_mul, add_comm]

/-- The adjoint of a translation is the inverse translation. -/
theorem shiftOp_adjoint (m : ℤ) :
    ContinuousLinearMap.adjoint (shiftOp m) = shiftOp (-m) := by
  symm
  rw [ContinuousLinearMap.eq_adjoint_iff]
  intro f g
  have h := inner_shiftOp_left (-m) f g
  simpa using h

/-- **The lattice translations are gauge unitaries.** -/
theorem shiftOp_unitary (m : ℤ) : shiftOp m ∈ unitary (L2Z →L[ℂ] L2Z) := by
  constructor <;>
    simp only [ContinuousLinearMap.star_eq_adjoint, shiftOp_adjoint,
      shiftOp_mul, neg_add_cancel, add_neg_cancel, shiftOp_zero]

/-- **Every non-trivial gauge transformation moves every non-zero state**: a
vector of `ℓ²(ℤ)` fixed by a non-trivial translation is zero (the sequence would
be periodic, hence not square-summable unless it vanishes). This is the book's
unconstrained condition in the concrete model. -/
theorem shiftOp_eq_self_iff {m : ℤ} (hm : m ≠ 0) {f : L2Z} (hf : shiftOp m f = f) :
    f = 0 := by
  have hper : ∀ (n : ℤ) (k : ℤ), (f : ℤ → ℂ) (k + n * m) = (f : ℤ → ℂ) k := by
    have hstep : ∀ k : ℤ, (f : ℤ → ℂ) (k + m) = (f : ℤ → ℂ) k := by
      intro k
      have := congrArg (fun v : L2Z => (v : ℤ → ℂ) k) hf
      simpa using this
    intro n
    induction n using Int.induction_on with
    | zero => intro k; simp
    | succ j ih =>
      intro k
      have : k + ((j : ℤ) + 1) * m = (k + j * m) + m := by ring
      rw [this, hstep (k + j * m), ih k]
    | pred j ih =>
      intro k
      have h1 : k + (-(j : ℤ) - 1) * m + m = k + (-(j : ℤ)) * m := by ring
      have h2 := hstep (k + (-(j : ℤ) - 1) * m)
      rw [h1] at h2
      rw [← h2, ih k]
  have hsum := summable_normSq f
  apply lp.ext
  funext k
  simp only [lp.coeFn_zero, Pi.zero_apply]
  -- the constant subfamily along the arithmetic progression `k + n * m`
  have hinj : Function.Injective (fun n : ℤ => k + n * m) := by
    intro a b hab
    simp only at hab
    have : a * m = b * m := by omega
    exact mul_right_cancel₀ hm this
  have hsub : Summable fun n : ℤ => ‖(f : ℤ → ℂ) (k + n * m)‖ ^ 2 :=
    hsum.comp_injective hinj
  have hconst : (fun n : ℤ => ‖(f : ℤ → ℂ) (k + n * m)‖ ^ 2)
      = fun _ : ℤ => ‖(f : ℤ → ℂ) k‖ ^ 2 := by
    funext n; rw [hper n k]
  rw [hconst] at hsub
  have htend := hsub.tendsto_cofinite_zero
  have hzero : ‖(f : ℤ → ℂ) k‖ ^ 2 = 0 :=
    tendsto_nhds_unique tendsto_const_nhds htend
  have hnk : ‖(f : ℤ → ℂ) k‖ = 0 := pow_eq_zero_iff (n := 2) (by norm_num) |>.1 hzero
  simpa using hnk

/-- No unit vector of `ℓ²(ℤ)` is invariant under the translation gauge group
(`book.tex` 2284): the gauge symmetry cannot be carried by the state. -/
theorem no_shift_invariant_unit_vector' :
    ¬ ∃ f : L2Z, ‖f‖ = 1 ∧ ∀ m : ℤ, shiftOp m f = f := by
  rintro ⟨f, hnorm, hinv⟩
  have h0 : f = 0 := shiftOp_eq_self_iff (m := 1) one_ne_zero (hinv 1)
  rw [h0, norm_zero] at hnorm
  exact one_ne_zero hnorm.symm

/-- The gauge fixing given by the whole spectrum of the translation algebra is
**incomplete**: the remnant gauge symmetry maps a state to a *different* state of
the same gauge equivalence class. -/
theorem shift_gauge_fixing_incomplete {f : L2Z} (hf : f ≠ 0) {m : ℤ} (hm : m ≠ 0) :
    shiftOp m f ≠ f :=
  fun h => hf (shiftOp_eq_self_iff hm h)

/-- Expectation values of a translation-invariant (physical) operator are the
same at every state of a gauge equivalence class. -/
theorem expectation_shift_invariant {A : L2Z →L[ℂ] L2Z}
    (hA : ∀ m : ℤ, A * shiftOp m = shiftOp m * A) (m : ℤ) (f : L2Z) :
    ⟪shiftOp m f, A (shiftOp m f)⟫_ℂ = ⟪f, A f⟫_ℂ := by
  have hcomm : A (shiftOp m f) = shiftOp m (A f) := by
    have := congrArg (fun T : L2Z →L[ℂ] L2Z => T f) (hA m)
    simpa [ContinuousLinearMap.mul_apply] using this
  rw [hcomm]
  exact (shiftEquiv m).inner_map_map f (A f)



/-! ## The gauge generators are excluded from the commutative algebra

`book.tex` (~2296): *"We define gauge-fixing as unconstrained whenever the gauge
generators are necessarily excluded from the commutative von Neumann algebra and
thus do not impose constraints on the spectrum of the commutative algebra."*

In this concrete model the commutative von Neumann algebra of the gauge-fixing is
the algebra of the multiplication operators `velocityOp v`, diagonal in the basis
`{e_k}`; the points of its spectrum are the basis labels `k ∈ ℤ`.  The statements
below are the Hilbert-space form of the general theory of
`BookProof.ChapterGaugeUnconstrainedSpectrum`: the translations are *not*
multiplication operators, so they are excluded from the algebra, and they impose
no condition on the spectrum — they merely permute its points, all of which
survive. -/

/-- The basis vector `e_j` of `ℓ²(ℤ)`, i.e. the point `j` of the spectrum of the
commutative algebra. -/
noncomputable def basisVecL2 (j : ℤ) : L2Z := lp.single 2 j (1 : ℂ)













