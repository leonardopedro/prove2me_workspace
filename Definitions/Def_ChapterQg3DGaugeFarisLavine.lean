/-! ## 2. The gauge-fixing forms -/

/-- The spatial directions among the four spacetime directions. -/
def spatial (j : Fin 3) : Fin 4 := j.succ

/-- **The 3D gauge condition** `Σ_j E_{jj}^a = 0`: the spatial divergence of the tetrad,
written in the coordinates that represent its spatial derivatives. -/
def div3Vec (a : Fin 4) (i : Fin 84) : ℝ :=
  ∑ j : Fin 3, (if i = idxDE (spatial j) (spatial j) a then 1 else 0)

/-- **The gauge fixing of the derivative coordinates** `E_{0ν}^a = 0`: the coordinates that
represent time derivatives of the tetrad are fixed to zero, which is what makes the
formulation three-dimensional. -/
def timeDerivVec (q : Fin 4 × Fin 4) (i : Fin 84) : ℝ :=
  if i = idxDE 0 q.1 q.2 then 1 else 0

/-- The complete gauge-fixing family: the four 3D gauge conditions and the sixteen
conditions on the derivative coordinates. -/
def qgGaugeVec : (Fin 4) ⊕ (Fin 4 × Fin 4) → Fin 84 → ℝ := Sum.elim div3Vec timeDerivVec

/-- The linear forms of the gauge-fixed Hamiltonian: the torsion forms together with the two
gauge-fixing families. -/
def qgFullVec : (Fin 64) ⊕ ((Fin 4) ⊕ (Fin 4 × Fin 4)) → Fin 84 → ℝ :=
  Sum.elim torsionVec qgGaugeVec











/-- **The complete 3D gauge-fixed gravity Hamiltonian on the one-particle space**:
`½ Σ_j κ_j π_j² + ½ Σ_m T_m² + ½ Σ (gauge-fixing forms)²`, with the independent coordinates
for the spatial derivatives of the tetrad, the 3D gauge condition and the gauge fixing of
the derivative coordinates. -/
def qg3DGaugeFixedHam : (polyGaussCore (d := 84)) →ₗ[ℂ] L2d 84 := sqSumOp qgKappa qgFullVec



/-! ## 3. The nested Fock space -/

/-- The `n`-particle lift of a one-particle family of linear forms: one copy of every form
in every particle's coordinate block. -/
def liftVecN {R : Type} [Fintype R] (v : R → Fin 84 → ℝ) (n : ℕ) (r : Fin n × R)
    (I : Fin (n * 84)) : ℝ :=
  if partOf I = r.1 then v r.2 (modeOf I) else 0

/-- **The `n`-particle gauge-fixed gravity Hamiltonian** `Σ_p h^{(p)}` on the
Gauss–polynomial core of `L²(ℝ^{84n})`. -/
def qgGaugeSectorHam (n : ℕ) : (polyGaussCore (d := n * 84)) →ₗ[ℂ] L2d (n * 84) :=
  sqSumOp (qgKappaN n) (liftVecN qgFullVec n)

/-- **The gauge-fixed gravity Hamiltonian on the nested Fock space.** -/
def qgGaugeOuterHam : qgOuterCore →ₗ[ℂ] qgOuterFock := dsOp (fun n : ℕ => qgGaugeSectorHam n)













